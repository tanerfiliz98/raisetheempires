# ==========================================
# NETWORK SETTINGS
# ==========================================

# Access permissions for Nginx (WEB_IP):
# 127.0.0.1 -> Localhost only (Accessible only from the host machine itself - Default)
# 0.0.0.0   -> Open to all (Any device on the network can connect)
WEB_IP=127.0.0.1

# The external port you will use to access the application via Nginx
WEB_PORT=5100